        <mxCell id="V6YtDEOGwNFaJWL3LwUE-49" parent="1" style="text;whiteSpace=wrap;html=1;fontColor=#3399FF;fontStyle=1" value="&lt;ul data-path-to-node=&quot;14&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,0,0&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Tra Cantante e &quot;incide&quot;: &lt;code data-path-to-node=&quot;14,0,0&quot; data-index-in-node=&quot;25&quot;&gt;1 a 1&lt;/code&gt; (Un cantante è uno solo).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,1,0&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Tra &quot;incide&quot; e Brano: &lt;code data-path-to-node=&quot;14,1,0&quot; data-index-in-node=&quot;22&quot;&gt;0 a n&lt;/code&gt; (Un cantante può incidere molti brani).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,2,0&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Tra Brano e &quot;contiene&quot;: &lt;code data-path-to-node=&quot;14,2,0&quot; data-index-in-node=&quot;24&quot;&gt;1 a 1&lt;/code&gt; (Un brano di solito appartiene a un solo album).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;14,3,0&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;Tra &quot;contiene&quot; e Album: &lt;code data-path-to-node=&quot;14,3,0&quot; data-index-in-node=&quot;24&quot;&gt;1 a n&lt;/code&gt; (Un album contiene molti brani).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;13,0,0&quot;&gt;&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span data-path-to-node=&quot;13,0,0&quot; data-index-in-node=&quot;0&quot;&gt;CANTANTE&amp;nbsp;&lt;/span&gt;&lt;span data-path-to-node=&quot;13,1,0&quot; data-index-in-node=&quot;0&quot; style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;a CONCERTO&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; data-index-in-node=&quot;0&quot; data-path-to-node=&quot;13,1,0&quot;&gt;:&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;code data-path-to-node=&quot;13,1,0&quot; data-index-in-node=&quot;26&quot; style=&quot;background-color: transparent;&quot;&gt;1 a n&lt;/code&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; (Una cantante può tenere zero concerti se è a riposo, o moltissimi se è in tour).&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="210" width="480" x="174" y="630" as="geometry" />
